# Copy to .env for local development. Never commit the real .env file.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty to use the local SQLite database.
DATABASE_URL=
# Provide this key locally for the chart-explanation feature; production uses protected project secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Local HTTP development: leave redirect off and HSTS at zero.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
